# deploy/production/.env — copy to .env, fill in, then `chmod 600 .env`.
#
# .env and .env.* are gitignored (see the repo .gitignore) EXCEPT this example. Never put a real
# password in this file.

# The field AP's address on this box — the interface the wearables reach the broker on.
# NOT 0.0.0.0: the broker must not be published on every interface (audit §4.6).
FIELD_AP_IP=192.168.4.1

# Broker credentials for the server's read-only 'ingest' account (server/mosquitto/ft.acl).
# Create them with server/mosquitto/dev-provision.sh, or by hand with mosquitto_passwd.
MQTT_USERNAME=ingest
MQTT_PASSWORD=

# Where the telemetry store and its backups live on THIS box. Must exist and be writable by uid 1000
# (the image runs as the non-root `bun` user):  sudo mkdir -p /srv/ft/data && sudo chown -R 1000:1000 /srv/ft
DATA_DIR=/srv/ft/data
# Names, password hashes, session config. Provisioned once; survives a store wipe.
CONFIG_DIR=/srv/ft/config

# The coach app's origin, exactly as the browser sends it. The WS upgrade and every POST are rejected
# unless the Origin matches (CSWSH/CSRF defence — ADR-0015).
ALLOWED_ORIGINS=https://pitch.local

# 'true' ONLY when a single trusted reverse proxy on this host appends X-Forwarded-For. Left false, the
# login rate limiter keys on the unspoofable socket peer.
TRUST_PROXY=false

# How long a raw fix may exist (ADR-0010). Backups inherit this bound — a copy older than the window is
# rotated away even when BACKUP_KEEP would have held it.
RETENTION_DAYS=30
BACKUP_KEEP=7

# Container-name prefix. Change it if you run more than one stack on this host (the dev stack uses ft-*).
STACK_PREFIX=ftprod

APP_VERSION=prod
LOG_LEVEL=info
