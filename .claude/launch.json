{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arch-doc",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4178",
        "--directory",
        "docs/architecture"
      ],
      "port": 4178
    },
    {
      "name": "coach-view",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "client",
      "port": 5173,
      "env": {
        "VITE_PROXY_TARGET": "http://127.0.0.1:3007",
        "VITE_DEFAULT_SESSION": "test"
      }
    },
    {
      "name": "coach-view-sim",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "client",
      "port": 5173,
      "env": {
        "VITE_PROXY_TARGET": "http://127.0.0.1:3000",
        "VITE_DEFAULT_SESSION": "test"
      }
    }
  ]
}